#!/usr/bin/env bash
#
# hpc-create-account -- maak een cluster-account aan in de LDAP-directory
#
# Draait als root op de controller. Schrijft via de Unix-socket (ldapi:///),
# zodat er nergens een LDAP-wachtwoord opgeslagen hoeft te worden: de kernel
# levert de identiteit.
#
#   hpc-create-account [opties] <gebruikersnaam>
#
# Opties:
#   --name "Voor Achter"   volledige naam
#   --oid <object-id>      Entra object-ID van het schoolaccount (aanbevolen)
#   --upn <e-mail>         schoolaccount, bv. voornaam.achternaam@kdg.be
#   --key <bestand>        publieke SSH-sleutel meteen installeren; er wordt
#                          dan GEEN wachtwoord gezet -- de gebruiker heeft er
#                          geen nodig en er valt dus niets te lekken
#   --with-password        toch een wachtwoord zetten, ook samen met --key
#   --groups a,b           extra groepen naast de persoonlijke groep
#   --shell <pad>          standaard /bin/bash
#   --uid <n> / --gid <n>  handmatig in plaats van automatisch
#   --no-home              home-directory niet aanmaken
#   --dry-run              toon wat er zou gebeuren, schrijf niets
#
# Exitcodes: 0 ok, 1 gebruiksfout, 2 preflight mislukt, 3 naam/nummer bezet

set -euo pipefail

BASE="dc=local"
PEOPLE="ou=People,$BASE"
GROUPBASE="ou=Group,$BASE"
HOMEROOT=/trinity/home
REGISTRY=/var/lib/hpc-accounts/registry.tsv
KEYHELPER=/usr/local/sbin/hpc-set-authorized-key
UID_MIN=1050
LDAP=(-Q -Y EXTERNAL -H ldapi:///)

C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_DIM=$'\033[90m'; C_OFF=$'\033[0m'
[ -t 1 ] || { C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_OFF=""; }

die()  { printf '\n%sFOUT: %s%s\n\n' "$C_ERR" "$*" "$C_OFF" >&2; exit "${EXITCODE:-1}"; }
ok()   { printf '  %s+%s %s\n' "$C_OK" "$C_OFF" "$*"; }
info() { printf '  %s.%s %s\n' "$C_DIM" "$C_OFF" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_OFF" "$*"; }
audit() { logger -t hpc-create-account -p auth.notice -- "$*" || true; }

# ----------------------------------------------------------------- argumenten
USERNAME=""
FULLNAME=""; OID=""; UPN=""; KEYFILE=""; EXTRA_GROUPS=""
SHELL_PATH=/bin/bash; WANT_UID=""; WANT_GID=""
DRYRUN=0; WITH_PASSWORD=0; MAKE_HOME=1

while [ $# -gt 0 ]; do
  case "$1" in
    --name)           FULLNAME="${2:-}"; shift 2 ;;
    --oid)            OID="${2:-}"; shift 2 ;;
    --upn)            UPN="${2:-}"; shift 2 ;;
    --key)            KEYFILE="${2:-}"; shift 2 ;;
    --groups)         EXTRA_GROUPS="${2:-}"; shift 2 ;;
    --shell)          SHELL_PATH="${2:-}"; shift 2 ;;
    --uid)            WANT_UID="${2:-}"; shift 2 ;;
    --gid)            WANT_GID="${2:-}"; shift 2 ;;
    --with-password)  WITH_PASSWORD=1; shift ;;
    --no-home)        MAKE_HOME=0; shift ;;
    --dry-run)        DRYRUN=1; shift ;;
    -h|--help)        sed -n '3,25p' "$0" | cut -c3-; exit 0 ;;
    --*)              die "onbekende optie: $1" ;;
    *)                [ -z "$USERNAME" ] || die "meerdere gebruikersnamen opgegeven"
                      USERNAME="$1"; shift ;;
  esac
done

[ -n "$USERNAME" ] || die "gebruik: $0 [opties] <gebruikersnaam>  (--help voor uitleg)"

# Zonder sleutel is een wachtwoord de enige manier om binnen te komen.
[ -n "$KEYFILE" ] || WITH_PASSWORD=1

# ------------------------------------------------------------------ preflight
EXITCODE=2
[ "$(id -u)" -eq 0 ] || die "moet als root draaien"

for exe in ldapsearch ldapadd ldappasswd ldapmodify ldapdelete; do
  command -v "$exe" >/dev/null 2>&1 || die "$exe ontbreekt (installeer openldap-clients)"
done

systemctl is-active --quiet slapd || die "slapd draait niet. Draai je dit op de controller?"

ldapsearch "${LDAP[@]}" -b "$BASE" -s base dn >/dev/null 2>&1 \
  || die "kan de directory niet lezen via ldapi:///. Draai je dit op de controller?"

# Schrijfrecht vooraf controleren, zodat we geen half account achterlaten.
# ldapmodify -n doet alles behalve daadwerkelijk schrijven.
if ! ldapmodify "${LDAP[@]}" -n >/dev/null 2>&1 <<LDIFTEST
dn: $PEOPLE
changetype: modify
replace: description
description: schrijftest
LDIFTEST
then
  die "geen schrijfrechten op de directory. Zie server/README.md, sectie 'Schrijfrechten'."
fi

if [ -n "$KEYFILE" ] && [ ! -r "$KEYFILE" ]; then
  die "sleutelbestand niet leesbaar: $KEYFILE"
fi
ok "preflight in orde"

# ----------------------------------------------------------- naam en nummers
EXITCODE=3
case "$USERNAME" in
  [a-z_]*) ;;
  *) die "gebruikersnaam moet met een kleine letter of _ beginnen" ;;
esac
case "$USERNAME" in
  *[!a-z0-9._-]*) die "gebruikersnaam mag alleen a-z, 0-9, punt, _ en - bevatten" ;;
  *.) die "gebruikersnaam mag niet op een punt eindigen" ;;
esac
[ "${#USERNAME}" -le 32 ] || die "gebruikersnaam te lang (max 32)"

getent passwd "$USERNAME" >/dev/null 2>&1 && die "gebruiker bestaat al: $USERNAME"
getent group  "$USERNAME" >/dev/null 2>&1 && die "groep bestaat al: $USERNAME"

ldap_max() { # $1 = filter, $2 = attribuut
  ldapsearch "${LDAP[@]}" -LLL -b "$BASE" "$1" "$2" 2>/dev/null \
    | awk -v a="$2:" '$1 == a { if ($2 + 0 > m) m = $2 + 0 } END { print m + 0 }'
}

# De tellers cn=uid en cn=gid lopen achter op de werkelijkheid (ze staan op
# 1050 en 150 terwijl 1063 en 162 in gebruik zijn), dus we kijken naar wat er
# daadwerkelijk bestaat. Een dubbel uitgedeeld UID betekent dat twee accounts
# stilzwijgend elkaars bestanden kunnen lezen.
if [ -z "$WANT_UID" ]; then
  WANT_UID=$(( $(ldap_max '(objectClass=posixAccount)' uidNumber) + 1 ))
  [ "$WANT_UID" -ge "$UID_MIN" ] || WANT_UID=$UID_MIN
fi
if [ -z "$WANT_GID" ]; then
  WANT_GID=$(( $(ldap_max '(objectClass=posixGroup)' gidNumber) + 1 ))
fi

while getent passwd "$WANT_UID" >/dev/null 2>&1; do WANT_UID=$((WANT_UID + 1)); done
while getent group  "$WANT_GID" >/dev/null 2>&1; do WANT_GID=$((WANT_GID + 1)); done

FULLNAME="${FULLNAME:-$USERNAME}"
SURNAME="${FULLNAME##* }"
GIVEN="${FULLNAME% *}"
[ "$GIVEN" = "$FULLNAME" ] && GIVEN=""
HOMEDIR="$HOMEROOT/$USERNAME"
TODAY_DAYS=$(( $(date +%s) / 86400 ))

info "uid $WANT_UID, gid $WANT_GID, home $HOMEDIR"

# ------------------------------------------------------------------- de LDIF
build_ldif() {
  printf 'dn: cn=%s,%s\n' "$USERNAME" "$GROUPBASE"
  printf 'objectClass: top\n'
  printf 'objectClass: groupOfMembers\n'
  printf 'objectClass: posixGroup\n'
  printf 'cn: %s\n' "$USERNAME"
  printf 'gidNumber: %s\n' "$WANT_GID"
  printf 'member: uid=%s,%s\n' "$USERNAME" "$PEOPLE"
  printf '\n'
  printf 'dn: uid=%s,%s\n' "$USERNAME" "$PEOPLE"
  printf 'objectClass: top\n'
  printf 'objectClass: person\n'
  printf 'objectClass: organizationalPerson\n'
  printf 'objectClass: inetOrgPerson\n'
  printf 'objectClass: posixAccount\n'
  printf 'objectClass: shadowAccount\n'
  printf 'uid: %s\n' "$USERNAME"
  printf 'cn: %s\n' "$FULLNAME"
  printf 'sn: %s\n' "$SURNAME"
  [ -n "$GIVEN" ] && printf 'givenName: %s\n' "$GIVEN"
  [ -n "$UPN" ] && printf 'mail: %s\n' "$UPN"
  printf 'loginShell: %s\n' "$SHELL_PATH"
  printf 'uidNumber: %s\n' "$WANT_UID"
  printf 'gidNumber: %s\n' "$WANT_GID"
  printf 'homeDirectory: %s\n' "$HOMEDIR"
  printf 'shadowMin: 0\n'
  printf 'shadowMax: 99999\n'
  printf 'shadowWarning: 7\n'
  printf 'shadowExpire: -1\n'
  printf 'shadowLastChange: %s\n' "$TODAY_DAYS"
}

if [ "$DRYRUN" -eq 1 ]; then
  echo
  echo "--- zou dit naar de directory schrijven ---"
  build_ldif
  echo "-------------------------------------------"
  [ -n "$EXTRA_GROUPS" ] && echo "plus lidmaatschap van: $EXTRA_GROUPS"
  [ "$MAKE_HOME" -eq 1 ] && echo "plus home-directory $HOMEDIR uit /etc/skel"
  [ "$WITH_PASSWORD" -eq 1 ] && echo "plus een willekeurig wachtwoord van 24 tekens"
  [ -n "$KEYFILE" ] && echo "plus de SSH-sleutel uit $KEYFILE"
  echo
  exit 0
fi

# -------------------------------------------------------------------- aanmaken
EXITCODE=1
build_ldif | ldapadd "${LDAP[@]}" >/dev/null || die "ldapadd is mislukt"
ok "LDAP-entry aangemaakt"

# Vanaf hier opruimen bij een fout: een half account is erger dan geen account.
cleanup_on_error() {
  warn "er ging iets mis; het halve account wordt opgeruimd"
  ldapdelete "${LDAP[@]}" "uid=$USERNAME,$PEOPLE" 2>/dev/null || true
  ldapdelete "${LDAP[@]}" "cn=$USERNAME,$GROUPBASE" 2>/dev/null || true
}
trap cleanup_on_error ERR

# --- extra groepen -----------------------------------------------------------
if [ -n "$EXTRA_GROUPS" ]; then
  IFS=',' read -ra glist <<< "$EXTRA_GROUPS"
  for g in "${glist[@]}"; do
    g="$(printf '%s' "$g" | tr -d '[:space:]')"
    [ -n "$g" ] || continue
    if ldapsearch "${LDAP[@]}" -LLL -b "cn=$g,$GROUPBASE" -s base dn >/dev/null 2>&1; then
      ldapmodify "${LDAP[@]}" >/dev/null <<LDIFGROUP
dn: cn=$g,$GROUPBASE
changetype: modify
add: member
member: uid=$USERNAME,$PEOPLE
LDIFGROUP
      ok "toegevoegd aan groep $g"
    else
      warn "groep $g bestaat niet, overgeslagen"
    fi
  done
fi

# --- tellers bijwerken -------------------------------------------------------
# Best effort: ze lopen toch al achter, maar we laten ze niet verder afdrijven.
for pair in "cn=uid,$BASE:$((WANT_UID + 1))" "cn=gid,$BASE:$((WANT_GID + 1))"; do
  dn="${pair%:*}"
  val="${pair##*:}"
  ldapmodify "${LDAP[@]}" >/dev/null 2>&1 <<LDIFCOUNT || true
dn: $dn
changetype: modify
replace: uidNumber
uidNumber: $val
LDIFCOUNT
done

# --- home directory ----------------------------------------------------------
if [ "$MAKE_HOME" -eq 1 ]; then
  if [ -e "$HOMEDIR" ]; then
    warn "$HOMEDIR bestaat al, ongemoeid gelaten"
  else
    mkdir -p "$HOMEDIR"
    cp -rT /etc/skel "$HOMEDIR" 2>/dev/null || true
    chown -R "$WANT_UID:$WANT_GID" "$HOMEDIR"
    chmod 0700 "$HOMEDIR"
    ok "home aangemaakt: $HOMEDIR"
  fi
fi

# --- wachtwoord --------------------------------------------------------------
NEWPW=""
if [ "$WITH_PASSWORD" -eq 1 ]; then
  NEWPW="$(set +o pipefail; LC_ALL=C tr -dc 'A-Za-z0-9_.!@#%+=-' < /dev/urandom | head -c 24)"
  [ "${#NEWPW}" -eq 24 ] || die "kon geen wachtwoord genereren"
  # Via -T en een tijdelijk bestand: met -s zou het wachtwoord in `ps` staan.
  pwfile="$(mktemp)"
  chmod 600 "$pwfile"
  printf '%s' "$NEWPW" > "$pwfile"
  ldappasswd "${LDAP[@]}" -T "$pwfile" "uid=$USERNAME,$PEOPLE" >/dev/null
  shred -u "$pwfile" 2>/dev/null || rm -f "$pwfile"
  ok "wachtwoord ingesteld"
fi

# --- SSH-sleutel -------------------------------------------------------------
if [ -n "$KEYFILE" ]; then
  if [ -x "$KEYHELPER" ]; then
    "$KEYHELPER" "$USERNAME" < "$KEYFILE" >/dev/null
    ok "SSH-sleutel geinstalleerd via $KEYHELPER"
  else
    install -d -m 0700 -o "$WANT_UID" -g "$WANT_GID" "$HOMEDIR/.ssh"
    install -m 0600 -o "$WANT_UID" -g "$WANT_GID" "$KEYFILE" "$HOMEDIR/.ssh/authorized_keys"
    ok "SSH-sleutel in $HOMEDIR/.ssh/authorized_keys"
  fi
fi

trap - ERR

# --- register ----------------------------------------------------------------
# De Entra object-ID is het enige dat nooit verandert. Namen en e-mailadressen
# wel: bij naamswijziging, bij dubbele namen (.1), en bij student -> personeel.
install -d -m 0700 -o root -g root "$(dirname "$REGISTRY")"
if [ ! -f "$REGISTRY" ]; then
  printf '# username\tuid\tentra_oid\tupn\taangemaakt\tdoor\n' > "$REGISTRY"
  chmod 0600 "$REGISTRY"
fi
printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$USERNAME" "$WANT_UID" "${OID:--}" "${UPN:--}" "$(date -Is)" "${SUDO_USER:-root}" >> "$REGISTRY"

[ -z "$OID" ] && warn "geen --oid opgegeven; het portaal kan dit account later niet automatisch koppelen"

audit "user=$USERNAME uid=$WANT_UID gid=$WANT_GID oid=${OID:--} upn=${UPN:--} by=${SUDO_USER:-root}"

# -------------------------------------------------------------------- overzicht
echo
echo "  Account aangemaakt"
echo "  =================="
echo "  gebruikersnaam : $USERNAME"
echo "  uid / gid      : $WANT_UID / $WANT_GID"
echo "  home           : $HOMEDIR"
if [ -n "$NEWPW" ]; then
  echo
  echo "  eenmalig wachtwoord : $NEWPW"
  echo
  warn "Stuur dit via een eenmalige link, niet via e-mail of chat."
  warn "Na het setupscript heeft de gebruiker het niet meer nodig."
else
  echo
  ok "Geen wachtwoord nodig: de sleutel staat er al."
fi
echo
echo "  Stuur de gebruiker deze instructie:"
echo "  https://github.com/KdG-OCDI/hpc-public#2-first-time-setup--run-one-command"
echo
