#!/usr/bin/env bash
#
# hpc-create-account -- maak een cluster-account aan
#
# Draait als root op de controller. Het LDAP-werk doet `obol`, het
# gebruikersbeheer van TrinityX: dat kent de bestaande structuur, deelt de
# uid- en gid-nummers uit en houdt zijn eigen boekhouding bij. Twee dingen
# die allebei nummers uitdelen, delen vroeg of laat hetzelfde nummer uit --
# en twee accounts met hetzelfde uid kunnen elkaars bestanden lezen.
#
# Dit script voegt toe wat obol niet doet: naamcontrole, een SSH-sleutel
# installeren, het schoolaccount vastleggen voor het SSO-portaal, en een
# variant waarbij er helemaal geen wachtwoord bestaat.
#
#   hpc-create-account [opties] <gebruikersnaam>
#
# Opties:
#   --name "Voor Achter"   volledige naam
#   --oid <object-id>      Entra object-ID van het schoolaccount (aanbevolen)
#   --upn <e-mail>         schoolaccount, bv. voornaam.achternaam@kdg.be
#                          Dit veld koppelt het schoolaccount aan dit account
#                          bij het inloggen via SSO -- laat het niet weg.
#   --key <bestand>        publieke SSH-sleutel meteen installeren; er wordt
#                          dan GEEN wachtwoord gezet
#   --with-password        toch een wachtwoord zetten, ook samen met --key
#   --groups a,b           extra groepen
#   --shell <pad>          standaard /bin/bash
#   --dry-run              toon wat er zou gebeuren, voer niets uit
#
# Exitcodes: 0 ok, 1 gebruiksfout, 2 preflight mislukt, 3 naam bezet

set -euo pipefail

OBOL=/usr/local/sbin/obol
REGISTRY=/var/lib/hpc-accounts/registry.tsv
KEYHELPER=/usr/local/sbin/hpc-set-authorized-key
HOMEROOT=/trinity/home

C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_ERR=$'\033[31m'; C_DIM=$'\033[90m'; C_OFF=$'\033[0m'
[ -t 1 ] || { C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_OFF=""; }

die()  { printf '\n%sFOUT: %s%s\n\n' "$C_ERR" "$*" "$C_OFF" >&2; exit "${EXITCODE:-1}"; }
ok()   { printf '  %s+%s %s\n' "$C_OK" "$C_OFF" "$*"; }
info() { printf '  %s.%s %s\n' "$C_DIM" "$C_OFF" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_OFF" "$*"; }
audit() { logger -t hpc-create-account -p auth.notice -- "$*" || true; }

# ----------------------------------------------------------------- argumenten
USERNAME=""
FULLNAME=""; OID=""; UPN=""; KEYFILE=""; EXTRA_GROUPS=""
SHELL_PATH=/bin/bash
DRYRUN=0; WITH_PASSWORD=0

while [ $# -gt 0 ]; do
  case "$1" in
    --name)           FULLNAME="${2:-}"; shift 2 ;;
    --oid)            OID="${2:-}"; shift 2 ;;
    --upn)            UPN="${2:-}"; shift 2 ;;
    --key)            KEYFILE="${2:-}"; shift 2 ;;
    --groups)         EXTRA_GROUPS="${2:-}"; shift 2 ;;
    --shell)          SHELL_PATH="${2:-}"; shift 2 ;;
    --with-password)  WITH_PASSWORD=1; shift ;;
    --dry-run)        DRYRUN=1; shift ;;
    -h|--help)        sed -n '3,30p' "$0" | cut -c3-; exit 0 ;;
    --*)              die "onbekende optie: $1" ;;
    *)                [ -z "$USERNAME" ] || die "meerdere gebruikersnamen opgegeven"
                      USERNAME="$1"; shift ;;
  esac
done

[ -n "$USERNAME" ] || die "gebruik: $0 [opties] <gebruikersnaam>  (--help voor uitleg)"

# Zonder sleutel is een wachtwoord de enige manier om binnen te komen.
[ -n "$KEYFILE" ] || WITH_PASSWORD=1

# ------------------------------------------------------------------ preflight
EXITCODE=2
[ "$(id -u)" -eq 0 ] || die "moet als root draaien"
[ -x "$OBOL" ] || die "$OBOL niet gevonden. Draai je dit op de controller?"
command -v getent >/dev/null 2>&1 || die "getent ontbreekt"

if [ -n "$KEYFILE" ] && [ ! -r "$KEYFILE" ]; then
  die "sleutelbestand niet leesbaar: $KEYFILE"
fi

# ----------------------------------------------------------- naam controleren
EXITCODE=3
case "$USERNAME" in
  [a-z_]*) ;;
  *) die "gebruikersnaam moet met een kleine letter of _ beginnen" ;;
esac
case "$USERNAME" in
  *[!a-z0-9._-]*) die "gebruikersnaam mag alleen a-z, 0-9, punt, _ en - bevatten" ;;
  *.) die "gebruikersnaam mag niet op een punt eindigen" ;;
esac
[ "${#USERNAME}" -le 32 ] || die "gebruikersnaam te lang (max 32)"

getent passwd "$USERNAME" >/dev/null 2>&1 && die "gebruiker bestaat al: $USERNAME"
getent group  "$USERNAME" >/dev/null 2>&1 && die "groep bestaat al: $USERNAME"

FULLNAME="${FULLNAME:-$USERNAME}"
SURNAME="${FULLNAME##* }"
GIVEN="${FULLNAME% *}"
[ "$GIVEN" = "$FULLNAME" ] && GIVEN=""

# Personeel in de groep staff, net als custom_mapping.sh doet bij SSO-logins,
# zodat handmatig en automatisch aangemaakte accounts gelijk uitkomen.
GROUPLIST="$EXTRA_GROUPS"
case "$UPN" in
  '') ;;
  *@student.kdg.be) ;;
  *@kdg.be) GROUPLIST="${GROUPLIST:+$GROUPLIST,}staff" ;;
esac

# --------------------------------------------------------- het obol-commando
obol_args=(user add "$USERNAME" --cn "$FULLNAME" --sn "$SURNAME" --shell "$SHELL_PATH")
[ -n "$GIVEN" ]     && obol_args+=(--givenName "$GIVEN")
[ -n "$UPN" ]       && obol_args+=(--mail "$UPN")
[ -n "$GROUPLIST" ] && obol_args+=(--groups "$GROUPLIST")
# --autogen-password laat obol het wachtwoord maken en tonen. Met --password
# zou het in de procestabel staan en dus zichtbaar zijn voor elke gebruiker.
[ "$WITH_PASSWORD" -eq 1 ] && obol_args+=(--autogen-password)

if [ "$DRYRUN" -eq 1 ]; then
  echo
  echo "--- zou dit uitvoeren ---"
  printf '%s' "$OBOL"; printf ' %q' "${obol_args[@]}"; echo
  echo "-------------------------"
  [ -n "$KEYFILE" ] && echo "plus de SSH-sleutel uit $KEYFILE"
  [ "$WITH_PASSWORD" -eq 0 ] && echo "geen wachtwoord: alleen toegang met de sleutel"
  [ -n "$OID" ] && echo "plus een regel in $REGISTRY met object-ID $OID"
  echo
  exit 0
fi

# ------------------------------------------------------------------ aanmaken
EXITCODE=1
if ! obol_out="$("$OBOL" "${obol_args[@]}" 2>&1)"; then
  printf '%s\n' "$obol_out" >&2
  die "obol user add is mislukt"
fi
ok "account aangemaakt via obol"

# Vanaf hier opruimen bij een fout: een half account is erger dan geen account.
cleanup_on_error() {
  warn "er ging iets mis; het account wordt weer verwijderd"
  "$OBOL" user delete "$USERNAME" >/dev/null 2>&1 || true
}
trap cleanup_on_error ERR

NEWPW=""
if [ "$WITH_PASSWORD" -eq 1 ]; then
  NEWPW="$(printf '%s' "$obol_out" | sed -n 's/^Generated password for user .*: //p' | head -1)"
  [ -n "$NEWPW" ] || warn "kon het gegenereerde wachtwoord niet uit de uitvoer van obol lezen"
fi

getent passwd "$USERNAME" >/dev/null 2>&1 || die "obol meldde succes maar het account is niet zichtbaar"

NEWUID="$(getent passwd "$USERNAME" | cut -d: -f3)"
NEWGID="$(getent passwd "$USERNAME" | cut -d: -f4)"
HOMEDIR="$(getent passwd "$USERNAME" | cut -d: -f6)"
HOMEDIR="${HOMEDIR:-$HOMEROOT/$USERNAME}"

# --- SSH-sleutel -------------------------------------------------------------
if [ -n "$KEYFILE" ]; then
  if [ -x "$KEYHELPER" ]; then
    "$KEYHELPER" "$USERNAME" < "$KEYFILE" >/dev/null
    ok "SSH-sleutel geinstalleerd via $KEYHELPER"
  else
    install -d -m 0700 -o "$NEWUID" -g "$NEWGID" "$HOMEDIR/.ssh"
    install -m 0600 -o "$NEWUID" -g "$NEWGID" "$KEYFILE" "$HOMEDIR/.ssh/authorized_keys"
    ok "SSH-sleutel in $HOMEDIR/.ssh/authorized_keys"
  fi
fi

trap - ERR

# --- register ----------------------------------------------------------------
# De Entra object-ID is het enige dat nooit verandert. Namen en e-mailadressen
# wel: bij naamswijziging, bij dubbele namen (.1), en bij student -> personeel.
install -d -m 0700 -o root -g root "$(dirname "$REGISTRY")"
if [ ! -f "$REGISTRY" ]; then
  printf '# username\tuid\tentra_oid\tupn\taangemaakt\tdoor\n' > "$REGISTRY"
  chmod 0600 "$REGISTRY"
fi
printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$USERNAME" "$NEWUID" "${OID:--}" "${UPN:--}" "$(date -Is)" "${SUDO_USER:-root}" >> "$REGISTRY"

[ -z "$UPN" ] && warn "geen --upn opgegeven; inloggen via SSO vindt dit account niet terug"
[ -z "$OID" ] && warn "geen --oid opgegeven; bij een naamswijziging is de koppeling niet te herstellen"

audit "user=$USERNAME uid=$NEWUID gid=$NEWGID oid=${OID:--} upn=${UPN:--} by=${SUDO_USER:-root}"

# ------------------------------------------------------------------ overzicht
echo
echo "  Account aangemaakt"
echo "  =================="
echo "  gebruikersnaam : $USERNAME"
echo "  uid / gid      : $NEWUID / $NEWGID"
echo "  home           : $HOMEDIR"
[ -n "$GROUPLIST" ] && echo "  groepen        : $USERNAME, $GROUPLIST"
if [ -n "$NEWPW" ]; then
  echo
  echo "  eenmalig wachtwoord : $NEWPW"
  echo
  warn "Stuur dit via een eenmalige link, niet via e-mail of chat."
  warn "Na het setupscript heeft de gebruiker het niet meer nodig."
else
  echo
  ok "Geen wachtwoord: alleen toegang met de SSH-sleutel."
fi
echo
echo "  Stuur de gebruiker deze instructie:"
echo "  https://github.com/KdG-OCDI/hpc-public#2-first-time-setup--run-one-command"
echo
